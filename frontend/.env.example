# Frontend build-time configuration.
#
# Vite inlines these at BUILD time, so changing one means rebuilding —
# restarting the server is not enough. On Vercel/Netlify, set them as
# environment variables and redeploy.
#
# Copy to .env.local for local overrides (git-ignored).

# Absolute origin of the API. Leave UNSET for local development, where
# vite.config.js proxies /api to localhost:8000.
# VITE_API_URL=https://your-api.onrender.com

# Enables the one-click demo account buttons on the login page.
# VITE_DEMO_MODE=true