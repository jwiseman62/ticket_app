# Copy to .env and fill in what you need. Every value is optional locally.
#   export $(cat .env | xargs) && uvicorn main:app --reload

# ── Database ────────────────────────────────────────────────────────
# Unset  -> SQLite at ./tickets.db (local development)
# Set    -> PostgreSQL. `postgres://` and `postgresql://` URLs are rewritten
#           automatically to use psycopg 3, and ?sslmode=require is preserved.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────
# Signs login tokens. If unset, a key is generated and written to
# backend/.jwt_secret. On a host with an ephemeral disk that means a NEW key
# on every deploy, silently signing everyone out. ALWAYS set this in production.
JWT_SECRET_KEY=change-me-in-production

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API from a browser.
# Must be the EXACT origin including scheme and port — note that
# http://localhost:5173 and http://127.0.0.1:5173 are different origins.
# CORS_ORIGINS=https://your-frontend.vercel.app

# ── Uploads ─────────────────────────────────────────────────────────
# true  -> attachment bytes are stored in the database (survives redeploys
#          on hosts with ephemeral disks, e.g. Render's free tier)
# unset -> written to backend/uploads/ (the local-development default)
# STORE_UPLOADS_IN_DB=true
# MAX_UPLOAD_MB=10

# ── Public demo ─────────────────────────────────────────────────────
# ── Email (Resend) ───────────────────────────────────────────────── #
# Render's free web services block outbound SMTP (ports 25/465/587), so mail
# goes over Resend's HTTPS API instead. Leave unset and every send is a
# silent no-op — fine for local work and for the public demo.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Until a domain is verified at resend.com/domains, the only usable sender is
# onboarding@resend.dev, and it ONLY delivers to the address on your own
# Resend account. Anything else comes back 403.
# MAIL_FROM=Tech Help <onboarding@resend.dev>

# Optional: an ops inbox that gets a copy of every notification.
# NOTIFY_EMAIL=

# SMTP still works if you host somewhere without the port block. Set
# SMTP_HOST instead of RESEND_API_KEY.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ── Email verification ───────────────────────────────────────────── #
# Off by default. Requesters confirm a 6-digit code at signup and again after
# a long gap; technicians and admins never do. Turning this on without a mail
# provider configured does nothing — the gate disables itself rather than
# locking everyone out.
# REQUIRE_EMAIL_VERIFICATION=false

# Days of inactivity before a verified requester is asked again.
# VERIFICATION_IDLE_DAYS=30
# VERIFY_CODE_TTL_MINUTES=15
# VERIFY_MAX_ATTEMPTS=5

# ── Archive and trash ────────────────────────────────────────────── #
# How long a closed ticket stays on the ticket board, and in the dashboard
# counters, before it moves to the archive where it is kept and stays
# searchable. 1 = 24 hours.
# CLOSED_GRACE_DAYS=1

# How long a deleted ticket stays in the trash, recoverable, before it is
# removed for good.
# TRASH_RETENTION_DAYS=30

# Enables /admin/reset-demo. The frontend has its own VITE_DEMO_MODE flag
# for the one-click login buttons.
# DEMO_MODE=true
# DEMO_RESET_TOKEN=generate-a-long-random-string

# ── Email (optional; blank SMTP_HOST disables notifications) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=